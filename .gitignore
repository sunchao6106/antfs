# Rust build artifacts (target 实际放在 VM 的 /var/tmp,这里兜底忽略)
/target
target/

# IDE
.idea/
.vscode/

# OS
.DS_Store

# 本地 agent/会话工具产物,不入库
.omo/
.opencode/

# devcluster 本地集群数据(可重生)
/.localcluster/

# devcluster 的本地参数文件(样例见 devcluster.toml.example,各机不同故不入库)
/devcluster.toml

# release 打包产物(dist/ 在仓库根;crates/admin/ui/dist 需入库,故只忽略根目录)
/dist/

# admin SPA 依赖 / 构建中间产物(dist/index.html 需入库供 include_str! 内嵌)
crates/admin/ui/node_modules/
crates/admin/ui/*.tsbuildinfo
.codemap/
.codemaker/codemap/
.codemaker/codeindex/
.codemaker/rules/codemap.mdc
.codemaker/mcps.json
.codemaker/hooks.json
.claude/skills/codemap-*/
.claude/skills/code-index-*/
.claude/settings.local.json
